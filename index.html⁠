<!DOCTYPE html>
<html lang="ja" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FC26 Career Universe Manager</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pitch: {
                            DEFAULT: '#0f172a',
                            card: '#1e293b',
                            accent: '#10b981',
                            gold: '#f59e0b',
                            danger: '#ef4444'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="assets/css/style.css">
    <!-- PWA Web App Manifest (Inline Mock) -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased pb-20 md:pb-0">

    <!-- Header Navigation -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-40 px-4 py-3 flex items-center justify-between shadow-lg">
        <div class="flex items-center space-x-3">
            <div class="bg-emerald-500 p-2 rounded-lg text-slate-950 font-black tracking-tighter text-lg">FC26</div>
            <div>
                <h1 class="font-bold text-base leading-tight">Career Universe Manager</h1>
                <p id="header-club-info" class="text-xs text-slate-400">クラブ未設定</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="app.openSettingsModal()" class="p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition">
                <i data-lucide="settings" class="w-5 h-5"></i>
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 space-y-6">

        <!-- Top Status Banner -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex items-center space-x-3">
                <div class="p-2 bg-emerald-500/10 text-emerald-400 rounded-lg"><i data-lucide="trophy" class="w-5 h-5"></i></div>
                <div>
                    <div class="text-xs text-slate-400">リーグ順位</div>
                    <div id="stat-rank" class="font-bold text-lg">1位</div>
                </div>
            </div>
            <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex items-center space-x-3">
                <div class="p-2 bg-blue-500/10 text-blue-400 rounded-lg"><i data-lucide="activity" class="w-5 h-5"></i></div>
                <div>
                    <div class="text-xs text-slate-400">通算戦績</div>
                    <div id="stat-record" class="font-bold text-lg">0勝 0分 0敗</div>
                </div>
            </div>
            <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex items-center space-x-3">
                <div class="p-2 bg-amber-500/10 text-amber-400 rounded-lg"><i data-lucide="alert-triangle" class="w-5 h-5"></i></div>
                <div>
                    <div class="text-xs text-slate-400">要対応（不満）</div>
                    <div id="stat-alerts" class="font-bold text-lg text-amber-400">0件</div>
                </div>
            </div>
            <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex items-center space-x-3">
                <div class="p-2 bg-purple-500/10 text-purple-400 rounded-lg"><i data-lucide="users" class="w-5 h-5"></i></div>
                <div>
                    <div class="text-xs text-slate-400">登録選手数</div>
                    <div id="stat-squad" class="font-bold text-lg">0名</div>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs (Desktop / Mobile Top) -->
        <div class="flex border-b border-slate-800 overflow-x-auto no-scrollbar space-x-1">
            <button onclick="app.switchTab('dashboard')" id="tab-dashboard" class="tab-btn active-tab">ダッシュボード</button>
            <button onclick="app.switchTab('universe')" id="tab-universe" class="tab-btn">Career Universe</button>
            <button onclick="app.switchTab('sddesk')" id="tab-sddesk" class="tab-btn">SDデスク</button>
            <button onclick="app.switchTab('match')" id="tab-match" class="tab-btn">試合記録/OCR</button>
            <button onclick="app.switchTab('squad')" id="tab-squad" class="tab-btn">選手・スカッド</button>
            <button onclick="app.switchTab('press')" id="tab-press" class="tab-btn">会見・メディア</button>
            <button onclick="app.switchTab('timeline')" id="tab-timeline" class="tab-btn">タイムライン</button>
        </div>

        <!-- Tab Content: Dashboard -->
        <section id="view-dashboard" class="tab-content space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Left Column (SD Desk Briefing & Critical Alert) -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-lg font-bold flex items-center gap-2">
                                <i data-lucide="building-2" class="w-5 h-5 text-emerald-400"></i> 最新 SD内部報告 (スポーツディレクター)
                            </h2>
                            <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full">社外秘</span>
                        </div>
                        <div id="dashboard-sd-briefing" class="text-sm text-slate-300 leading-relaxed bg-slate-950 p-4 rounded-xl border border-slate-800/80">
                            データが入力されると、SDからの定期レポートが自動更新されます。
                        </div>
                    </div>

                    <!-- Squad Satisfaction Overview -->
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
                        <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
                            <i data-lucide="heart-pulse" class="w-5 h-5 text-amber-400"></i> 要注意・不満を抱える選手
                        </h2>
                        <div id="dashboard-discontent-list" class="space-y-3">
                            <!-- JS Dynamically Injected -->
                        </div>
                    </div>
                </div>

                <!-- Right Column (Recent News & Supporter Vibe) -->
                <div class="space-y-6">
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
                        <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
                            <i data-lucide="newspaper" class="w-5 h-5 text-blue-400"></i> 最新メディア報道
                        </h2>
                        <div id="dashboard-news-feed" class="space-y-3">
                            <!-- JS Injected -->
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
                        <h2 class="text-lg font-bold mb-3 flex items-center gap-2">
                            <i data-lucide="message-square" class="w-5 h-5 text-purple-400"></i> サポーターの反応 (SNS)
                        </h2>
                        <div id="dashboard-fan-vibe" class="space-y-2 text-sm text-slate-300">
                            <!-- JS Injected -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tab Content: Career Universe -->
        <section id="view-universe" class="tab-content hidden space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <h2 class="text-xl font-bold mb-1">Career Universe Status</h2>
                <p class="text-xs text-slate-400 mb-6">ゲーム内事実に基づきAIがシミュレートしたクラブ内外の心理・政治・人間関係の一覧</p>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Red: Urgent Action Needed -->
                    <div class="bg-slate-950 border border-red-500/30 rounded-xl p-4">
                        <h3 class="font-bold text-red-400 border-b border-red-500/20 pb-2 mb-3 flex items-center justify-between">
                            <span>🔴 要対応 (不満/面談要求)</span>
                        </h3>
                        <div id="universe-red-list" class="space-y-3"></div>
                    </div>

                    <!-- Yellow: Caution -->
                    <div class="bg-slate-950 border border-amber-500/30 rounded-xl p-4">
                        <h3 class="font-bold text-amber-400 border-b border-amber-500/20 pb-2 mb-3 flex items-center justify-between">
                            <span>🟡 注意 (変化の兆候)</span>
                        </h3>
                        <div id="universe-yellow-list" class="space-y-3"></div>
                    </div>

                    <!-- Green: Good Conditions -->
                    <div class="bg-slate-950 border border-emerald-500/30 rounded-xl p-4">
                        <h3 class="font-bold text-emerald-400 border-b border-emerald-500/20 pb-2 mb-3 flex items-center justify-between">
                            <span>🟢 良好 (信頼・安定)</span>
                        </h3>
                        <div id="universe-green-list" class="space-y-3"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tab Content: SD Desk -->
        <section id="view-sddesk" class="tab-content hidden space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-xl font-bold">スポーツディレクター (SD) 執務室</h2>
                        <p class="text-xs text-slate-400">フロント・代理人・選手・メディアからの報告とアクション指示</p>
                    </div>
                    <button onclick="app.triggerSDSimulation()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl transition flex items-center gap-2">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i> SD報告を更新 (AI再評価)
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-4">
                        <h3 class="font-bold text-slate-200 border-b border-slate-800 pb-2">選手面談の受入れ / 実施</h3>
                        <div id="sddesk-talk-requests" class="space-y-3"></div>
                    </div>

                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-4">
                        <h3 class="font-bold text-slate-200 border-b border-slate-800 pb-2">代理人からの打診 / プレッシャー</h3>
                        <div id="sddesk-agent-requests" class="space-y-3"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tab Content: Match Record & OCR -->
        <section id="view-match" class="tab-content hidden space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <h2 class="text-xl font-bold mb-4">試合結果の入力 (絶対的事実)</h2>
                
                <!-- OCR Upload Mock Box -->
                <div class="border-2 border-dashed border-slate-700 bg-slate-950/50 hover:bg-slate-950 rounded-2xl p-6 text-center cursor-pointer transition mb-6" onclick="document.getElementById('ocr-file-input').click()">
                    <i data-lucide="upload-cloud" class="w-10 h-10 text-emerald-400 mx-auto mb-2"></i>
                    <p class="text-sm font-medium">FC26 リザルト画面のスクリーンショットをアップロード (OCR解析)</p>
                    <p class="text-xs text-slate-500 mt-1">※AI/OCR解析後に確認画面が表示され、ユーザーが「確定」するまで事実は保存されません</p>
                    <input type="file" id="ocr-file-input" class="hidden" accept="image/*" onchange="app.handleOCRUpload(event)">
                </div>

                <!-- Manual Match Form -->
                <form id="match-form" onsubmit="app.saveMatchRecord(event)" class="space-y-4">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">日付</label>
                            <input type="date" id="match-date" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">大会 / 節</label>
                            <input type="text" id="match-comp" placeholder="例: リーグ 節12" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">対戦相手</label>
                            <input type="text" id="match-opponent" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">Home / Away</label>
                            <select id="match-ha" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm">
                                <option value="Home">Home</option>
                                <option value="Away">Away</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">自チーム得点</label>
                            <input type="number" id="match-score-gf" value="0" min="0" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-sm font-bold text-center">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">相手得点</label>
                            <input type="number" id="match-score-ga" value="0" min="0" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-sm font-bold text-center">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">ポゼッション (%)</label>
                            <input type="number" id="match-possession" value="50" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-sm text-center">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-400 mb-1">使用フォーメーション</label>
                            <input type="text" id="match-formation" placeholder="例: 4-3-3" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-sm">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs text-slate-400 mb-1">先発選手リスト (カンマ区切り または 選択)</label>
                        <input type="text" id="match-starters" placeholder="例: Lukovic, Boutrah, Muller..." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm">
                    </div>

                    <div>
                        <label class="block text-xs text-slate-400 mb-1">試合メモ・監督ノート</label>
                        <textarea id="match-notes" rows="2" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm" placeholder="交代指示や tactical change のメモ"></textarea>
                    </div>

                    <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 font-bold text-white rounded-xl transition">
                        試合データを絶対的事実として保存 & シミュレーション更新
                    </button>
                </form>
            </div>
        </section>

        <!-- Tab Content: Squad Management -->
        <section id="view-squad" class="tab-content hidden space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-xl font-bold">選手スカッド一覧</h2>
                        <p class="text-xs text-slate-400">ゲーム内での能力値と、内部心理ステータス（SD見解）</p>
                    </div>
                    <button onclick="app.openAddPlayerModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 font-bold text-xs rounded-xl transition flex items-center gap-1">
                        <i data-lucide="user-plus" class="w-4 h-4"></i> 選手手動追加
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-950 text-slate-400 uppercase text-xs">
                            <tr>
                                <th class="p-3">名前</th>
                                <th class="p-3">Pos</th>
                                <th class="p-3">OVR</th>
                                <th class="p-3">役割</th>
                                <th class="p-3">直近10試合先発</th>
                                <th class="p-3">満足度 (内部)</th>
                                <th class="p-3">アクション</th>
                            </tr>
                        </thead>
                        <tbody id="squad-table-body" class="divide-y divide-slate-800">
                            <!-- JS Injected -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Tab Content: Press & Media -->
        <section id="view-press" class="tab-content hidden space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <h2 class="text-xl font-bold mb-4">記者会見 / 監督インタビュー</h2>
                <div id="press-conference-room" class="space-y-4">
                    <!-- Dynamic Interactive Press Room -->
                </div>
            </div>
        </section>

        <!-- Tab Content: Timeline -->
        <section id="view-timeline" class="tab-content hidden space-y-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                <h2 class="text-xl font-bold mb-4">Career Timeline (クラブ全史)</h2>
                <div id="timeline-list" class="space-y-4 relative border-l-2 border-slate-800 ml-4 pl-6">
                    <!-- JS Injected -->
                </div>
            </div>
        </section>

    </main>

    <!-- Modal: Player Talk Simulation -->
    <div id="modal-talk" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 id="talk-modal-title" class="font-bold text-lg">選手面談</h3>
                <button onclick="app.closeModal('modal-talk')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <div id="talk-chat-history" class="h-64 overflow-y-auto space-y-3 bg-slate-950 p-4 rounded-xl text-sm border border-slate-800">
                <!-- Chat Injected -->
            </div>
            <div class="flex gap-2">
                <input type="text" id="talk-user-input" placeholder="監督としての言葉を入力..." class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-sm">
                <button onclick="app.sendTalkMessage()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 font-bold text-sm rounded-xl">送信</button>
            </div>
        </div>
    </div>

    <!-- Modal: Settings & JSON Backup -->
    <div id="modal-settings" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-lg">設定 & データ管理</h3>
                <button onclick="app.closeModal('modal-settings')" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <div class="space-y-3">
                <button onclick="app.exportJSON()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 font-bold text-sm text-white rounded-xl">JSONデータをバックアップ (保存)</button>
                <div class="pt-2">
                    <label class="block text-xs text-slate-400 mb-1">JSONデータ復元</label>
                    <input type="file" id="import-json-file" accept=".json" onchange="app.importJSON(event)" class="text-xs text-slate-400">
                </div>
                <div class="border-t border-slate-800 pt-3">
                    <button onclick="app.resetAllData()" class="w-full py-2.5 bg-red-600/20 hover:bg-red-600/30 text-red-400 font-bold text-sm rounded-xl border border-red-500/30">全データリセット</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="md:hidden fixed bottom-0 inset-x-0 bg-slate-900/90 backdrop-blur-md border-t border-slate-800 z-40 flex justify-around py-2 px-1 text-[10px] text-slate-400">
        <button onclick="app.switchTab('dashboard')" class="flex flex-col items-center gap-1 active-mobile-tab">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
        </button>
        <button onclick="app.switchTab('universe')" class="flex flex-col items-center gap-1">
            <i data-lucide="globe" class="w-5 h-5"></i> Universe
        </button>
        <button onclick="app.switchTab('sddesk')" class="flex flex-col items-center gap-1">
            <i data-lucide="briefcase" class="w-5 h-5"></i> SDデスク
        </button>
        <button onclick="app.switchTab('match')" class="flex flex-col items-center gap-1">
            <i data-lucide="plus-circle" class="w-5 h-5"></i> 記録
        </button>
        <button onclick="app.switchTab('squad')" class="flex flex-col items-center gap-1">
            <i data-lucide="users" class="w-5 h-5"></i> スカッド
        </button>
    </nav>

    <script src="assets/js/storage.js"></script>
    <script src="assets/js/engine.js"></script>
    <script src="assets/js/app.js"></script>
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
